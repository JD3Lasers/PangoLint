# Keep source files LF for stable diffs, but check out PangoScript scripts as
# CRLF. BEYOND's PangoScript editor paste path treats LF-only clipboard text as
# one logical line, so operator-facing .BeyondCode fixtures must stay CRLF in
# the working tree.

.gitattributes  text eol=lf
*.BeyondCode    text eol=crlf
*.md            text eol=lf
*.json          text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf

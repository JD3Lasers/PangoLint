// PangoLint VSIX smoke-test fixture
// Open this file after installing pangolint-0.4.9.vsix.
// Expected behaviors are noted inline.

// 1. Syntax highlighting: keywords, strings, comments, numbers should colorize.
// 2. Language mode in the status bar should read "PangoScript".

// --- Known commands: no diagnostics ---
SelectZone 1
Brightness 50
WaitForBeat 7, 1
DisplayPopup "smoke test ok"

// --- Unknown command: yellow squiggle, code "unknown-command" ---
TotallyMadeUpCommand 99

// --- Unclosed string: red squiggle, code "unclosed-string" ---
DisplayPopup "no closing quote

// --- Unbalanced parens: yellow squiggle, code "unbalanced-parentheses" ---
if ((1 > 0) DisplayPopup "bad"

// --- Inline label + goto: should NOT warn ---
mylabel: WaitForBeat 7, 1
goto mylabel

// --- Goto missing target: warning, code "missing-label" ---
goto DefinitelyNotALabel

// --- Uninitialized variable read: warning, code "uninitialized-variable" ---
var zoneName
OscOutTTS "/x", "s", zoneName

// --- Variable assigned then read: NO warning ---
var beatRate
beatRate = 120
OscOutTTS "/y", "i", beatRate

// --- Dotted property access: NO warning ---
var zoneBrightness
zoneBrightness = Zone.0.Brightness
/beyond/zone/<zoneBrightness>/select 1

// --- Omitted terminal exit: hint, code "missing-terminal-exit" ---
//     BEYOND accepts this shape; PangoLint recommends exit as a fall-through guard.

// --- Completion check: type "Sel" and Ctrl/Cmd+Space — SelectZone should appear ---
// --- Format check: run "Format Document" (Shift+Alt+F) — content should be preserved ---
// --- Command palette: "PangoLint: Validate Current Script" should run and show count ---
// --- Command palette: "PangoLint: Test BEYOND Connection" should attempt UDP/OSC; expect a
//     "BEYOND readback failed: Timed out…" notification unless you have a real BEYOND host. ---

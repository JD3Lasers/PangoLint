// CYAN BUTTON 1

OnClick:
    // --- Hold/swap session integration ---
    // Mark that a manual pick occurred so the next Swap starts a fresh session
    COLORPICKER.SWAP_RESETSESSION.Tag = 1
    // If a swap fade is running, hold PRIMARY (channel 0) so the fade won't overwrite this snap
    if (COLORPICKER.SWAP_FADEACTIVE.Tag > 0.5) COLORPICKER.SWAP_HOLD0.Tag = 1

    if (value <= 0.5) goto CyanOff
    var pastel; pastel = COLORPICKER.PASTELMODEPRIMARY.value
    if (pastel > 0.5) goto SendCyanPastel
    ColorChannel.0.Color = 16776960       // normal cyan
    goto AfterCyan
SendCyanPastel:
    ColorChannel.0.Color = 16777088       // pastel cyan
AfterCyan:
    var c; c = ColorChannel.0.Color
    var sat; sat = COLORPICKER.SATSLIDER.Value
    var satPct; satPct = sat + 100
    var b; b = c & 255
    var g; g = (c >> 8) & 255
    var r; r = (c >> 16) & 255
    var bright; bright = r
    if (g > bright) bright = g
    if (b > bright) bright = b
    var nr; nr = (r * satPct + bright * (100 - satPct)) / 100
    var ng; ng = (g * satPct + bright * (100 - satPct)) / 100
    var nb; nb = (b * satPct + bright * (100 - satPct)) / 100
    var colourSat; colourSat = nb | (ng << 8) | (nr << 16)
    COLORPICKER.PRIMARYCOLOR.ColorOff    = colourSat
    COLORPICKER.PRIMARYCOLOR.ColorOn     = colourSat
    COLORPICKER.PRIMARYCOLOR.ColorActive = colourSat
    COLORPICKER.PRIMARYSELECTED.Tag      = 7
    if (COLORPICKER.MONOCHROME.Tag > 0.5) goto CopyToSecondaryCyan
    exit
CyanOff:
    ColorChannel.0.Color = 0
    COLORPICKER.PRIMARYCOLOR.ColorOff    = 0
    COLORPICKER.PRIMARYCOLOR.ColorOn     = 0
    COLORPICKER.PRIMARYCOLOR.ColorActive = 0
    COLORPICKER.PRIMARYSELECTED.Tag      = 0
    if (COLORPICKER.MONOCHROME.Tag > 0.5) goto CyanOffMono
    exit
CyanOffMono:
    ColorChannel.1.Color = 0
    COLORPICKER.SECONDARYCOLOR.ColorOff    = 0
    COLORPICKER.SECONDARYCOLOR.ColorOn     = 0
    COLORPICKER.SECONDARYCOLOR.ColorActive = 0
    COLORPICKER.SECONDARYSELECTED.Tag      = 0
    COLORPICKER.PASTELMODESECONDARY.value  = COLORPICKER.PASTELMODEPRIMARY.value
    if (COLORPICKER.PASTELMODESECONDARY.value > 0.5) goto ApplySecondaryPastel
    goto ApplySecondaryNormal

CopyToSecondaryCyan:
    ColorChannel.1.Color = ColorChannel.0.Color
    COLORPICKER.SECONDARYSELECTED.Tag = 7
    COLORPICKER.PASTELMODESECONDARY.value = COLORPICKER.PASTELMODEPRIMARY.value
    COLORPICKER.SECONDARYCOLOR.ColorOff    = COLORPICKER.PRIMARYCOLOR.ColorOff
    COLORPICKER.SECONDARYCOLOR.ColorOn     = COLORPICKER.PRIMARYCOLOR.ColorOn
    COLORPICKER.SECONDARYCOLOR.ColorActive = COLORPICKER.PRIMARYCOLOR.ColorActive
    COLORPICKER.REDBUTTON2.value    = 0
    COLORPICKER.ORANGEBUTTON2.value = 0
    COLORPICKER.YELLOWBUTTON2.value = 0
    COLORPICKER.LIMEBUTTON2.value   = 0
    COLORPICKER.GREENBUTTON2.value  = 0
    COLORPICKER.CLOVERBUTTON2.value = 0
    COLORPICKER.CYANBUTTON2.value   = 1
    COLORPICKER.AQUABUTTON2.value   = 0
    COLORPICKER.BLUEBUTTON2.value   = 0
    COLORPICKER.PURPLEBUTTON2.value = 0
    COLORPICKER.MAGENTABUTTON2.value= 0
    COLORPICKER.ROSEBUTTON2.value   = 0
    COLORPICKER.WHITEBUTTON2.value  = 0
    if (COLORPICKER.PASTELMODESECONDARY.value > 0.5) goto ApplySecondaryPastel
    goto ApplySecondaryNormal

// Pastel palette for all secondary buttons
ApplySecondaryPastel:
    COLORPICKER.REDBUTTON2.ColorOff    = 0; COLORPICKER.REDBUTTON2.ColorOn     = 8421631;  COLORPICKER.REDBUTTON2.ColorActive = 8421631;  COLORPICKER.REDBUTTON2.Caption     = "P.RED"
    COLORPICKER.ORANGEBUTTON2.ColorOff    = 0; COLORPICKER.ORANGEBUTTON2.ColorOn     = 8438015;  COLORPICKER.ORANGEBUTTON2.ColorActive = 8438015;  COLORPICKER.ORANGEBUTTON2.Caption     = "P.ORANGE"
    COLORPICKER.YELLOWBUTTON2.ColorOff    = 0; COLORPICKER.YELLOWBUTTON2.ColorOn     = 8454143;  COLORPICKER.YELLOWBUTTON2.ColorActive = 8454143;  COLORPICKER.YELLOWBUTTON2.Caption     = "P.YELLOW"
    COLORPICKER.LIMEBUTTON2.ColorOff    = 0; COLORPICKER.LIMEBUTTON2.ColorOn     = 8454080;  COLORPICKER.LIMEBUTTON2.ColorActive = 8454080;  COLORPICKER.LIMEBUTTON2.Caption     = "P.LIME"
    COLORPICKER.GREENBUTTON2.ColorOff    = 0; COLORPICKER.GREENBUTTON2.ColorOn     = 8454016;  COLORPICKER.GREENBUTTON2.ColorActive = 8454016;  COLORPICKER.GREENBUTTON2.Caption     = "P.GREEN"
    COLORPICKER.CLOVERBUTTON2.ColorOff    = 0; COLORPICKER.CLOVERBUTTON2.ColorOn     = 12648320; COLORPICKER.CLOVERBUTTON2.ColorActive = 12648320; COLORPICKER.CLOVERBUTTON2.Caption     = "P.CLOVER"
    COLORPICKER.CYANBUTTON2.ColorOff    = 0; COLORPICKER.CYANBUTTON2.ColorOn     = 16777088; COLORPICKER.CYANBUTTON2.ColorActive = 16777088; COLORPICKER.CYANBUTTON2.Caption     = "P.CYAN"
    COLORPICKER.AQUABUTTON2.ColorOff    = 0; COLORPICKER.AQUABUTTON2.ColorOn     = 16760960; COLORPICKER.AQUABUTTON2.ColorActive = 16760960; COLORPICKER.AQUABUTTON2.Caption     = "P.AQUA"
    COLORPICKER.BLUEBUTTON2.ColorOff    = 0; COLORPICKER.BLUEBUTTON2.ColorOn     = 16744576; COLORPICKER.BLUEBUTTON2.ColorActive = 16744576; COLORPICKER.BLUEBUTTON2.Caption     = "P.BLUE"
    COLORPICKER.PURPLEBUTTON2.ColorOff    = 0; COLORPICKER.PURPLEBUTTON2.ColorOn     = 16744640; COLORPICKER.PURPLEBUTTON2.ColorActive = 16744640; COLORPICKER.PURPLEBUTTON2.Caption     = "P.PURPLE"
    COLORPICKER.MAGENTABUTTON2.ColorOff    = 0; COLORPICKER.MAGENTABUTTON2.ColorOn     = 16744703; COLORPICKER.MAGENTABUTTON2.ColorActive = 16744703; COLORPICKER.MAGENTABUTTON2.Caption     = "P.MAGENTA"
    COLORPICKER.ROSEBUTTON2.ColorOff    = 0; COLORPICKER.ROSEBUTTON2.ColorOn     = 12615935; COLORPICKER.ROSEBUTTON2.ColorActive = 12615935; COLORPICKER.ROSEBUTTON2.Caption     = "P.ROSE"
    COLORPICKER.WHITEBUTTON2.ColorOff    = 0; COLORPICKER.WHITEBUTTON2.ColorOn     = 16777215; COLORPICKER.WHITEBUTTON2.ColorActive = 16777215; COLORPICKER.WHITEBUTTON2.Caption     = "WHITE"
    exit

// Normal palette for all secondary buttons
ApplySecondaryNormal:
    COLORPICKER.REDBUTTON2.ColorOff    = 0; COLORPICKER.REDBUTTON2.ColorOn     = 255;      COLORPICKER.REDBUTTON2.ColorActive = 255;      COLORPICKER.REDBUTTON2.Caption     = "RED"
    COLORPICKER.ORANGEBUTTON2.ColorOff    = 0; COLORPICKER.ORANGEBUTTON2.ColorOn     = 33023;    COLORPICKER.ORANGEBUTTON2.ColorActive = 33023;    COLORPICKER.ORANGEBUTTON2.Caption     = "ORANGE"
    COLORPICKER.YELLOWBUTTON2.ColorOff    = 0; COLORPICKER.YELLOWBUTTON2.ColorOn     = 65535;    COLORPICKER.YELLOWBUTTON2.ColorActive = 65535;    COLORPICKER.YELLOWBUTTON2.Caption     = "YELLOW"
    COLORPICKER.LIMEBUTTON2.ColorOff    = 0; COLORPICKER.LIMEBUTTON2.ColorOn     = 65408;    COLORPICKER.LIMEBUTTON2.ColorActive = 65408;    COLORPICKER.LIMEBUTTON2.Caption     = "LIME"
    COLORPICKER.GREENBUTTON2.ColorOff    = 0; COLORPICKER.GREENBUTTON2.ColorOn     = 65280;    COLORPICKER.GREENBUTTON2.ColorActive = 65280;    COLORPICKER.GREENBUTTON2.Caption     = "GREEN"
    COLORPICKER.CLOVERBUTTON2.ColorOff    = 0; COLORPICKER.CLOVERBUTTON2.ColorOn     = 8453888;  COLORPICKER.CLOVERBUTTON2.ColorActive = 8453888;  COLORPICKER.CLOVERBUTTON2.Caption     = "CLOVER"
    COLORPICKER.CYANBUTTON2.ColorOff    = 0; COLORPICKER.CYANBUTTON2.ColorOn     = 16776960; COLORPICKER.CYANBUTTON2.ColorActive = 16776960; COLORPICKER.CYANBUTTON2.Caption     = "CYAN"
    COLORPICKER.AQUABUTTON2.ColorOff    = 0; COLORPICKER.AQUABUTTON2.ColorOn     = 16744448; COLORPICKER.AQUABUTTON2.ColorActive = 16744448; COLORPICKER.AQUABUTTON2.Caption     = "AQUA"
    COLORPICKER.BLUEBUTTON2.ColorOff    = 0; COLORPICKER.BLUEBUTTON2.ColorOn     = 16711680; COLORPICKER.BLUEBUTTON2.ColorActive = 16711680; COLORPICKER.BLUEBUTTON2.Caption     = "BLUE"
    COLORPICKER.PURPLEBUTTON2.ColorOff    = 0; COLORPICKER.PURPLEBUTTON2.ColorOn     = 16711808; COLORPICKER.PURPLEBUTTON2.ColorActive = 16711808; COLORPICKER.PURPLEBUTTON2.Caption     = "PURPLE"
    COLORPICKER.MAGENTABUTTON2.ColorOff    = 0; COLORPICKER.MAGENTABUTTON2.ColorOn     = 16711935; COLORPICKER.MAGENTABUTTON2.ColorActive = 16711935; COLORPICKER.MAGENTABUTTON2.Caption     = "MAGENTA"
    COLORPICKER.ROSEBUTTON2.ColorOff    = 0; COLORPICKER.ROSEBUTTON2.ColorOn     = 8388863;  COLORPICKER.ROSEBUTTON2.ColorActive = 8388863;  COLORPICKER.ROSEBUTTON2.Caption     = "ROSE"
    COLORPICKER.WHITEBUTTON2.ColorOff    = 0; COLORPICKER.WHITEBUTTON2.ColorOn     = 16777215; COLORPICKER.WHITEBUTTON2.ColorActive = 16777215; COLORPICKER.WHITEBUTTON2.Caption     = "WHITE"
    exit


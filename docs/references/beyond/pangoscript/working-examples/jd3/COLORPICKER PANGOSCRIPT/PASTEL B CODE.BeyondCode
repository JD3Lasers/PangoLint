    COLORPICKER.AQUABUTTON2.ColorOff    = 0;
    COLORPICKER.AQUABUTTON2.ColorOn     = 16744448;
    COLORPICKER.AQUABUTTON2.ColorActive = 16744448;
    COLORPICKER.AQUABUTTON2.Caption     = "AQUA";

    COLORPICKER.BLUEBUTTON2.ColorOff    = 0;
    COLORPICKER.BLUEBUTTON2.ColorOn     = 16711680;
    COLORPICKER.BLUEBUTTON2.ColorActive = 16711680;
    COLORPICKER.BLUEBUTTON2.Caption     = "BLUE";

    COLORPICKER.PURPLEBUTTON2.ColorOff    = 0;
    COLORPICKER.PURPLEBUTTON2.ColorOn     = 16711808;
    COLORPICKER.PURPLEBUTTON2.ColorActive = 16711808;
    COLORPICKER.PURPLEBUTTON2.Caption     = "PURPLE";

    COLORPICKER.MAGENTABUTTON2.ColorOff    = 0;
    COLORPICKER.MAGENTABUTTON2.ColorOn     = 16711935;
    COLORPICKER.MAGENTABUTTON2.ColorActive = 16711935;
    COLORPICKER.MAGENTABUTTON2.Caption     = "MAGENTA";


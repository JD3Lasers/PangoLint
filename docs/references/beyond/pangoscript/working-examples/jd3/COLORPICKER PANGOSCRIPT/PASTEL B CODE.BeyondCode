PastelOffSecondary:
    // --- Restore normal colours for each secondary button ---
    COLORPICKER.REDBUTTON2.ColorOff    = 0;
    COLORPICKER.REDBUTTON2.ColorOn     = 255;
    COLORPICKER.REDBUTTON2.ColorActive = 255;
    COLORPICKER.REDBUTTON2.Caption     = "RED";

    COLORPICKER.ORANGEBUTTON2.ColorOff    = 0;
    COLORPICKER.ORANGEBUTTON2.ColorOn     = 33023;
    COLORPICKER.ORANGEBUTTON2.ColorActive = 33023;
    COLORPICKER.ORANGEBUTTON2.Caption     = "ORANGE";

    COLORPICKER.YELLOWBUTTON2.ColorOff    = 0;
    COLORPICKER.YELLOWBUTTON2.ColorOn     = 65535;
    COLORPICKER.YELLOWBUTTON2.ColorActive = 65535;
    COLORPICKER.YELLOWBUTTON2.Caption     = "YELLOW";


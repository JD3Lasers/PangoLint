// PASTEL SECONDARY COLOR MODE TOGGLE BUTTON (attached to PASTELMODESECONDARY)

OnClick:
    // Toggle pastel mode: if the button is on (value > 0.5), enter pastel mode; else normal
    if (value > 0.5) goto PastelOnSecondary
    goto PastelOffSecondary

PastelOnSecondary:
    // --- Set pastel colours for each secondary button (off state remains black) ---
    COLORPICKER.REDBUTTON2.ColorOff    = 0;
    COLORPICKER.REDBUTTON2.ColorOn     = 8421631;
    COLORPICKER.REDBUTTON2.ColorActive = 8421631;
    COLORPICKER.REDBUTTON2.Caption     = "P.RED";

    COLORPICKER.ORANGEBUTTON2.ColorOff    = 0;
    COLORPICKER.ORANGEBUTTON2.ColorOn     = 8438015;
    COLORPICKER.ORANGEBUTTON2.ColorActive = 8438015;
    COLORPICKER.ORANGEBUTTON2.Caption     = "P.ORANGE";

    COLORPICKER.YELLOWBUTTON2.ColorOff    = 0;
    COLORPICKER.YELLOWBUTTON2.ColorOn     = 8454143;
    COLORPICKER.YELLOWBUTTON2.ColorActive = 8454143;
    COLORPICKER.YELLOWBUTTON2.Caption     = "P.YELLOW";

    COLORPICKER.LIMEBUTTON2.ColorOff    = 0;
    COLORPICKER.LIMEBUTTON2.ColorOn     = 8454080;
    COLORPICKER.LIMEBUTTON2.ColorActive = 8454080;
    COLORPICKER.LIMEBUTTON2.Caption     = "P.LIME";

    COLORPICKER.GREENBUTTON2.ColorOff    = 0;
    COLORPICKER.GREENBUTTON2.ColorOn     = 8454016;
    COLORPICKER.GREENBUTTON2.ColorActive = 8454016;
    COLORPICKER.GREENBUTTON2.Caption     = "P.GREEN";

    COLORPICKER.CLOVERBUTTON2.ColorOff    = 0;
    COLORPICKER.CLOVERBUTTON2.ColorOn     = 12648320;
    COLORPICKER.CLOVERBUTTON2.ColorActive = 12648320;
    COLORPICKER.CLOVERBUTTON2.Caption     = "P.CLOVER";

    COLORPICKER.CYANBUTTON2.ColorOff    = 0;
    COLORPICKER.CYANBUTTON2.ColorOn     = 16777088;
    COLORPICKER.CYANBUTTON2.ColorActive = 16777088;
    COLORPICKER.CYANBUTTON2.Caption     = "P.CYAN";

    COLORPICKER.AQUABUTTON2.ColorOff    = 0;
    COLORPICKER.AQUABUTTON2.ColorOn     = 16760960;
    COLORPICKER.AQUABUTTON2.ColorActive = 16760960;
    COLORPICKER.AQUABUTTON2.Caption     = "P.AQUA";

    COLORPICKER.BLUEBUTTON2.ColorOff    = 0;
    COLORPICKER.BLUEBUTTON2.ColorOn     = 16744576;
    COLORPICKER.BLUEBUTTON2.ColorActive = 16744576;
    COLORPICKER.BLUEBUTTON2.Caption     = "P.BLUE";

    COLORPICKER.PURPLEBUTTON2.ColorOff    = 0;
    COLORPICKER.PURPLEBUTTON2.ColorOn     = 16744640;
    COLORPICKER.PURPLEBUTTON2.ColorActive = 16744640;
    COLORPICKER.PURPLEBUTTON2.Caption     = "P.PURPLE";

    COLORPICKER.MAGENTABUTTON2.ColorOff    = 0;
    COLORPICKER.MAGENTABUTTON2.ColorOn     = 16744703;
    COLORPICKER.MAGENTABUTTON2.ColorActive = 16744703;
    COLORPICKER.MAGENTABUTTON2.Caption     = "P.MAGENTA";

    COLORPICKER.ROSEBUTTON2.ColorOff    = 0;
    COLORPICKER.ROSEBUTTON2.ColorOn     = 12615935;
    COLORPICKER.ROSEBUTTON2.ColorActive = 12615935;
    COLORPICKER.ROSEBUTTON2.Caption     = "P.ROSE";

    COLORPICKER.WHITEBUTTON2.ColorOff    = 0;
    COLORPICKER.WHITEBUTTON2.ColorOn     = 16777215;
    COLORPICKER.WHITEBUTTON2.ColorActive = 16777215;
    COLORPICKER.WHITEBUTTON2.Caption     = "WHITE";

    // --- Refresh channel 1 and the secondary swatch based on which button is active ---
    if (COLORPICKER.REDBUTTON2.value    > 0.5) goto SetRedPastelSecondary
    if (COLORPICKER.ORANGEBUTTON2.value > 0.5) goto SetOrangePastelSecondary
    if (COLORPICKER.YELLOWBUTTON2.value > 0.5) goto SetYellowPastelSecondary
    if (COLORPICKER.LIMEBUTTON2.value   > 0.5) goto SetLimePastelSecondary
    if (COLORPICKER.GREENBUTTON2.value  > 0.5) goto SetGreenPastelSecondary
    if (COLORPICKER.CLOVERBUTTON2.value > 0.5) goto SetCloverPastelSecondary
    if (COLORPICKER.CYANBUTTON2.value   > 0.5) goto SetCyanPastelSecondary
    if (COLORPICKER.AQUABUTTON2.value   > 0.5) goto SetAquaPastelSecondary
    if (COLORPICKER.BLUEBUTTON2.value   > 0.5) goto SetBluePastelSecondary
    if (COLORPICKER.PURPLEBUTTON2.value > 0.5) goto SetPurplePastelSecondary
    if (COLORPICKER.MAGENTABUTTON2.value> 0.5) goto SetMagentaPastelSecondary
    if (COLORPICKER.ROSEBUTTON2.value   > 0.5) goto SetRosePastelSecondary
    if (COLORPICKER.WHITEBUTTON2.value  > 0.5) goto SetWhitePastelSecondary
    exit

// Pastel colour assignments for channel 1
SetRedPastelSecondary:
    ColorChannel.1.Color = 8421631;
    var c; c = ColorChannel.1.Color;
    COLORPICKER.SECONDARYCOLOR.ColorOff    = c;
    COLORPICKER.SECONDARYCOLOR.ColorOn     = c;
    COLORPICKER.SECONDARYCOLOR.ColorActive = c;
    exit


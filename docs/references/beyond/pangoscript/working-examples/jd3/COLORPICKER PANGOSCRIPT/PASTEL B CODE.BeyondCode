    COLORPICKER.ROSEBUTTON2.ColorOn     = 8388863;
    COLORPICKER.ROSEBUTTON2.ColorActive = 8388863;
    COLORPICKER.ROSEBUTTON2.Caption     = "ROSE";

    COLORPICKER.WHITEBUTTON2.ColorOff    = 0;
    COLORPICKER.WHITEBUTTON2.ColorOn     = 16777215;
    COLORPICKER.WHITEBUTTON2.ColorActive = 16777215;
    COLORPICKER.WHITEBUTTON2.Caption     = "WHITE";

    // --- Refresh channel 1 and the secondary swatch based on the active button ---
    if (COLORPICKER.REDBUTTON2.value    > 0.5) goto SetRedNormalSecondary
    if (COLORPICKER.ORANGEBUTTON2.value > 0.5) goto SetOrangeNormalSecondary
    if (COLORPICKER.YELLOWBUTTON2.value > 0.5) goto SetYellowNormalSecondary
    if (COLORPICKER.LIMEBUTTON2.value   > 0.5) goto SetLimeNormalSecondary
    if (COLORPICKER.GREENBUTTON2.value  > 0.5) goto SetGreenNormalSecondary
    if (COLORPICKER.CLOVERBUTTON2.value > 0.5) goto SetCloverNormalSecondary
    if (COLORPICKER.CYANBUTTON2.value   > 0.5) goto SetCyanNormalSecondary
    if (COLORPICKER.AQUABUTTON2.value   > 0.5) goto SetAquaNormalSecondary
    if (COLORPICKER.BLUEBUTTON2.value   > 0.5) goto SetBlueNormalSecondary
    if (COLORPICKER.PURPLEBUTTON2.value > 0.5) goto SetPurpleNormalSecondary
    if (COLORPICKER.MAGENTABUTTON2.value> 0.5) goto SetMagentaNormalSecondary
    if (COLORPICKER.ROSEBUTTON2.value   > 0.5) goto SetRoseNormalSecondary
    if (COLORPICKER.WHITEBUTTON2.value  > 0.5) goto SetWhiteNormalSecondary
    exit


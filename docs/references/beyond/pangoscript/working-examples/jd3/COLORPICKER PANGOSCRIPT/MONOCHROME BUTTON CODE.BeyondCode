// MONOCHROME TOGGLE BUTTON
// updates primary palette UI, and locks both channels together.

OnClick:
    if (value > 0.5) goto MonoOn
    goto MonoOff

MonoOn:
    // Flag mono
    Tag = 1

    // Primary pastel button shows generic caption in MONO
    COLORPICKER.PASTELMODEPRIMARY.Caption = "PASTEL"

    // Monochrome button caption updated 
    COLORPICKER.MONOCHROME.Caption = "MONOCHROME ACTIVE"

    // Hide secondary row + its pastel toggle
    COLORPICKER.REDBUTTON2.Visible     = 0
    COLORPICKER.ORANGEBUTTON2.Visible  = 0
    COLORPICKER.YELLOWBUTTON2.Visible  = 0
    COLORPICKER.LIMEBUTTON2.Visible    = 0
    COLORPICKER.GREENBUTTON2.Visible   = 0
    COLORPICKER.CLOVERBUTTON2.Visible  = 0
    COLORPICKER.CYANBUTTON2.Visible    = 0
    COLORPICKER.AQUABUTTON2.Visible    = 0
    COLORPICKER.BLUEBUTTON2.Visible    = 0
    COLORPICKER.PURPLEBUTTON2.Visible  = 0
    COLORPICKER.MAGENTABUTTON2.Visible = 0
    COLORPICKER.ROSEBUTTON2.Visible    = 0
    COLORPICKER.WHITEBUTTON2.Visible   = 0
    COLORPICKER.PASTELMODESECONDARY.Visible = 0

    // Hide Swap color and mode
    COLORPICKER.SWAPMODE.Visible = 0
    COLORPICKER.SWAPCOLORS.Visible = 0

    // Show mono indicators
    COLORPICKER.MONOCHROMEINDICATOR.Visible  = 1
    COLORPICKER.MONOCHROMEINDICATOR2.Visible = 1
    COLORPICKER.MONOCHROMEINDICATOR3.Visible = 1

    // Clear all secondary button values
    COLORPICKER.REDBUTTON2.value     = 0
    COLORPICKER.ORANGEBUTTON2.value  = 0
    COLORPICKER.YELLOWBUTTON2.value  = 0
    COLORPICKER.LIMEBUTTON2.value    = 0
    COLORPICKER.GREENBUTTON2.value   = 0
    COLORPICKER.CLOVERBUTTON2.value  = 0
    COLORPICKER.CYANBUTTON2.value    = 0
    COLORPICKER.AQUABUTTON2.value    = 0
    COLORPICKER.BLUEBUTTON2.value    = 0
    COLORPICKER.PURPLEBUTTON2.value  = 0
    COLORPICKER.MAGENTABUTTON2.value = 0
    COLORPICKER.ROSEBUTTON2.value    = 0
    COLORPICKER.WHITEBUTTON2.value   = 0

    // Prefer primary→secondary, else secondary→primary
    var p; p = COLORPICKER.PRIMARYSELECTED.Tag
    if (p > 0) goto CopyPrimaryToSecondary

    var s; s = COLORPICKER.SECONDARYSELECTED.Tag
    if (s > 0) goto CopySecondaryToPrimary

    goto EndMonoOn

CopyPrimaryToSecondary:
    // Copy base colour + pastel flag to hidden secondary
    ColorChannel.1.Color = ColorChannel.0.Color
    COLORPICKER.SECONDARYSELECTED.Tag     = p
    COLORPICKER.PASTELMODESECONDARY.value = COLORPICKER.PASTELMODEPRIMARY.value

    // Keep secondary swatch identical to the visible primary swatch
    COLORPICKER.SECONDARYCOLOR.ColorOff    = COLORPICKER.PRIMARYCOLOR.ColorOff
    COLORPICKER.SECONDARYCOLOR.ColorOn     = COLORPICKER.PRIMARYCOLOR.ColorOn
    COLORPICKER.SECONDARYCOLOR.ColorActive = COLORPICKER.PRIMARYCOLOR.ColorActive
    goto EndMonoOn

CopySecondaryToPrimary:
    // Mirror secondary into primary so MONO has a visible colour
    ColorChannel.0.Color            = ColorChannel.1.Color
    COLORPICKER.PRIMARYSELECTED.Tag = s
    COLORPICKER.PASTELMODEPRIMARY.value = COLORPICKER.PASTELMODESECONDARY.value

    // Update the visible primary swatch to match the hidden secondary swatch
    var sc; sc = COLORPICKER.SECONDARYCOLOR.ColorOn
    COLORPICKER.PRIMARYCOLOR.ColorOff    = sc
    COLORPICKER.PRIMARYCOLOR.ColorOn     = sc
    COLORPICKER.PRIMARYCOLOR.ColorActive = sc

    // Normalize the primary row button states
    COLORPICKER.REDBUTTON1.value     = 0
    COLORPICKER.ORANGEBUTTON1.value  = 0
    COLORPICKER.YELLOWBUTTON1.value  = 0
    COLORPICKER.LIMEBUTTON1.value    = 0
    COLORPICKER.GREENBUTTON1.value   = 0
    COLORPICKER.CLOVERBUTTON1.value  = 0
    COLORPICKER.CYANBUTTON1.value    = 0
    COLORPICKER.AQUABUTTON1.value    = 0
    COLORPICKER.BLUEBUTTON1.value    = 0
    COLORPICKER.PURPLEBUTTON1.value  = 0
    COLORPICKER.MAGENTABUTTON1.value = 0
    COLORPICKER.ROSEBUTTON1.value    = 0
    COLORPICKER.WHITEBUTTON1.value   = 0
    if (s = 1)  COLORPICKER.REDBUTTON1.value     = 1
    if (s = 2)  COLORPICKER.ORANGEBUTTON1.value  = 1
    if (s = 3)  COLORPICKER.YELLOWBUTTON1.value  = 1
    if (s = 4)  COLORPICKER.LIMEBUTTON1.value    = 1
    if (s = 5)  COLORPICKER.GREENBUTTON1.value   = 1
    if (s = 6)  COLORPICKER.CLOVERBUTTON1.value  = 1
    if (s = 7)  COLORPICKER.CYANBUTTON1.value    = 1
    if (s = 8)  COLORPICKER.AQUABUTTON1.value    = 1
    if (s = 9)  COLORPICKER.BLUEBUTTON1.value    = 1
    if (s = 10) COLORPICKER.PURPLEBUTTON1.value  = 1
    if (s = 11) COLORPICKER.MAGENTABUTTON1.value = 1
    if (s = 12) COLORPICKER.ROSEBUTTON1.value    = 1
    if (s = 13) COLORPICKER.WHITEBUTTON1.value   = 1

    // Keep both channels in lockstep
    ColorChannel.1.Color = ColorChannel.0.Color

    // Apply the PRIMARY palette UI to match the flag (fix for Pastel B → MONO)
    if (COLORPICKER.PASTELMODEPRIMARY.value > 0.5) goto ApplyPrimaryPastel
    goto ApplyPrimaryNormal

EndMonoOn:
    // Ensure the hidden secondary palette matches its flag
    if (COLORPICKER.PASTELMODESECONDARY.value > 0.5) goto ApplySecondaryPastel
    goto ApplySecondaryNormal


MonoOff:
    // Unflag mono
    Tag = 0

    // Restore "PASTEL A" caption
    COLORPICKER.PASTELMODEPRIMARY.Caption = "PASTEL A"

    // Monochrome button caption updated 
    COLORPICKER.MONOCHROME.Caption = "MONOCHROME OFF"

    // Show secondary row and toggle
    COLORPICKER.REDBUTTON2.Visible     = 1
    COLORPICKER.ORANGEBUTTON2.Visible  = 1
    COLORPICKER.YELLOWBUTTON2.Visible  = 1
    COLORPICKER.LIMEBUTTON2.Visible    = 1
    COLORPICKER.GREENBUTTON2.Visible   = 1
    COLORPICKER.CLOVERBUTTON2.Visible  = 1
    COLORPICKER.CYANBUTTON2.Visible    = 1
    COLORPICKER.AQUABUTTON2.Visible    = 1
    COLORPICKER.BLUEBUTTON2.Visible    = 1
    COLORPICKER.PURPLEBUTTON2.Visible  = 1
    COLORPICKER.MAGENTABUTTON2.Visible = 1
    COLORPICKER.ROSEBUTTON2.Visible    = 1
    COLORPICKER.WHITEBUTTON2.Visible   = 1
    COLORPICKER.PASTELMODESECONDARY.Visible = 1

    // Show Swap color and mode
    COLORPICKER.SWAPMODE.Visible = 1
    COLORPICKER.SWAPCOLORS.Visible = 1

    // Hide indicators
    COLORPICKER.MONOCHROMEINDICATOR.Visible  = 0
    COLORPICKER.MONOCHROMEINDICATOR2.Visible = 0
    COLORPICKER.MONOCHROMEINDICATOR3.Visible = 0
    // If a primary is selected, rebuild secondary from it; else clear secondary
    var p2; p2 = COLORPICKER.PRIMARYSELECTED.Tag
    if (p2 > 0) goto RestoreFromPrimary

    // No primary selected — clear secondary and reset to normal palette
    ColorChannel.1.Color = 0
    COLORPICKER.SECONDARYSELECTED.Tag     = 0
    COLORPICKER.PASTELMODESECONDARY.value = 0

    COLORPICKER.REDBUTTON2.value     = 0
    COLORPICKER.ORANGEBUTTON2.value  = 0
    COLORPICKER.YELLOWBUTTON2.value  = 0
    COLORPICKER.LIMEBUTTON2.value    = 0
    COLORPICKER.GREENBUTTON2.value   = 0
    COLORPICKER.CLOVERBUTTON2.value  = 0
    COLORPICKER.CYANBUTTON2.value    = 0
    COLORPICKER.AQUABUTTON2.value    = 0
    COLORPICKER.BLUEBUTTON2.value    = 0
    COLORPICKER.PURPLEBUTTON2.value  = 0
    COLORPICKER.MAGENTABUTTON2.value = 0
    COLORPICKER.ROSEBUTTON2.value    = 0
    COLORPICKER.WHITEBUTTON2.value   = 0

    COLORPICKER.SECONDARYCOLOR.ColorOff    = 0
    COLORPICKER.SECONDARYCOLOR.ColorOn     = 0
    COLORPICKER.SECONDARYCOLOR.ColorActive = 0

    // Reset secondary to normal palette UI
    goto ApplySecondaryNormal

RestoreFromPrimary:
    // Copy base colour to secondary and keep current SAT (copy swatch)
    ColorChannel.1.Color = ColorChannel.0.Color
    COLORPICKER.SECONDARYSELECTED.Tag     = p2
    COLORPICKER.PASTELMODESECONDARY.value = COLORPICKER.PASTELMODEPRIMARY.value

    COLORPICKER.SECONDARYCOLOR.ColorOff    = COLORPICKER.PRIMARYCOLOR.ColorOff
    COLORPICKER.SECONDARYCOLOR.ColorOn     = COLORPICKER.PRIMARYCOLOR.ColorOn
    COLORPICKER.SECONDARYCOLOR.ColorActive = COLORPICKER.PRIMARYCOLOR.ColorActive

    // Reset secondary button values
    COLORPICKER.REDBUTTON2.value     = 0
    COLORPICKER.ORANGEBUTTON2.value  = 0
    COLORPICKER.YELLOWBUTTON2.value  = 0
    COLORPICKER.LIMEBUTTON2.value    = 0
    COLORPICKER.GREENBUTTON2.value   = 0
    COLORPICKER.CLOVERBUTTON2.value  = 0
    COLORPICKER.CYANBUTTON2.value    = 0
    COLORPICKER.AQUABUTTON2.value    = 0
    COLORPICKER.BLUEBUTTON2.value    = 0
    COLORPICKER.PURPLEBUTTON2.value  = 0
    COLORPICKER.MAGENTABUTTON2.value = 0
    COLORPICKER.ROSEBUTTON2.value    = 0
    COLORPICKER.WHITEBUTTON2.value   = 0

    // Activate correct secondary button
    if (p2 = 1)  COLORPICKER.REDBUTTON2.value    = 1
    if (p2 = 2)  COLORPICKER.ORANGEBUTTON2.value = 1
    if (p2 = 3)  COLORPICKER.YELLOWBUTTON2.value = 1
    if (p2 = 4)  COLORPICKER.LIMEBUTTON2.value   = 1
    if (p2 = 5)  COLORPICKER.GREENBUTTON2.value  = 1
    if (p2 = 6)  COLORPICKER.CLOVERBUTTON2.value = 1
    if (p2 = 7)  COLORPICKER.CYANBUTTON2.value   = 1
    if (p2 = 8)  COLORPICKER.AQUABUTTON2.value   = 1
    if (p2 = 9)  COLORPICKER.BLUEBUTTON2.value   = 1
    if (p2 = 10) COLORPICKER.PURPLEBUTTON2.value = 1
    if (p2 = 11) COLORPICKER.MAGENTABUTTON2.value= 1
    if (p2 = 12) COLORPICKER.ROSEBUTTON2.value   = 1
    if (p2 = 13) COLORPICKER.WHITEBUTTON2.value  = 1

    // Apply palette to secondary per its flag
    if (COLORPICKER.PASTELMODESECONDARY.value > 0.5) goto ApplySecondaryPastel
    goto ApplySecondaryNormal



// PangoLint expect: unsupported-for-range-syntax
// Purpose: fixture for Delphi-style For assignment ranges that BEYOND rejects.
// BEYOND validation 2026-05-07: rejected before runtime; no callbacks emitted.
// BEYOND parser error: Operation expected: to.
// BEYOND parser location: line 10, text `For sweepIndex = 1 To 3`

var requestId
var sweepIndex

requestId = "pangolint-fail-for-range-001"
sweepIndex = 0

For sweepIndex = 1 To 3
  OscOutTTS "/pangolint/fail/for-range", "si", requestId, sweepIndex
Next
exit

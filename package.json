    "check:mcp": "npm --workspace mcp run verify:tarball",
    "vscode:prepublish": "npm run compile",
    "audit:prod": "npm audit --omit=dev",
    "check:public": "npm run audit:imports && npm run compile && npm run lint && npm test && npm run lint:examples && npm run verify:package",
    "check:release": "npm run check:public && npm run check:mcp",
    "check": "npm run build:knowledge && npm run build:mcp-control-reference && npm run build:object-data-quality-audit && npm run check:public && npm run check:mcp"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jd3/pangolint/object-tree/evidence/value.schema.json",
  "title": "PangoScript Object Range Evidence Report",
  "type": "object",
  "required": ["schemaVersion", "runtime", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtime": {
      "type": "object",
      "required": ["observedAt", "operatorSupervised"],
      "properties": {
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "beyondVersion": {
          "type": "string",
          "minLength": 1
        },
        "operatorSupervised": {
          "const": true
        },
        "noLaserConnected": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "parentIssue": {
      "type": "integer"
    },
    "batchIssue": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "required": [
        "objectPath",
        "probePath",
        "probeMode",
        "shipsMetadata",
        "valueType",
        "evidenceLevel",
        "baseline",
        "testedValues",
        "restore",
        "evidenceNote",
        "locationAware"
      ],
      "properties": {
        "objectPath": {
          "type": "string",
          "minLength": 1
        },
        "probePath": {
          "type": "string",
          "minLength": 1
        },
        "probeMode": {
          "enum": ["readback-only", "write-readback", "command-readback", "command-write-readback"]
        },
        "shipsMetadata": {
          "type": "boolean"
        },
        "valueType": {
          "enum": ["number", "integer", "float", "string", "boolean", "enum", "unknown"]
        },
        "evidenceLevel": {
          "enum": ["documented", "observed", "inferred", "unverified"]
        },
        "boundaryBehavior": {
          "enum": ["clamp", "reject", "no-op", "wrap", "pass-through", "unknown"]
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "valueRange": {
          "$ref": "#/$defs/valueRange"
        },
        "acceptedValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acceptedValue"
          }
        },
        "testedValues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testedValue"
          }
        },
        "restore": {
          "$ref": "#/$defs/restore"
        },
        "evidenceNote": {
          "type": "string",
          "minLength": 1
        },
        "deferReason": {
          "type": "string",
          "minLength": 1
        },
        "locationAware": {
          "type": "boolean"
        },
        "locationContext": {
          "$ref": "#/$defs/locationContext"
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": ["string", "number", "boolean", "null"]
        },
        "typeTag": {
          "enum": ["f", "i", "s"]
        }
      },
      "additionalProperties": false
    },
    "valueRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "minInclusive": {
          "type": "boolean"
        },
        "maxInclusive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "acceptedValue": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": ["string", "number", "boolean"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "testedValue": {
      "type": "object",
      "required": ["readback", "behavior"],
      "properties": {
        "input": {
          "type": ["string", "number", "boolean"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "readback": {
          "type": ["string", "number", "boolean", "null"]
        },
        "behavior": {
          "enum": ["clamp", "reject", "no-op", "wrap", "pass-through", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "restore": {
      "type": "object",
      "required": ["strategy", "notes"],
      "properties": {
        "strategy": {
          "enum": ["not-needed", "restored-baseline", "command-restore", "manual-restore", "prefix-retired"]
        },
        "restoredValue": {
          "type": ["string", "number", "boolean", "null"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "locationContext": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["indexed-root", "workspace-slot", "quickfx-slot", "showfile-alias", "hardware-instance"]
        },
        "populationDependent": {
          "type": "boolean"
        },
        "concreteContext": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}

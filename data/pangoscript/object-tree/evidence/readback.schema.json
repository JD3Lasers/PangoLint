{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jd3/pangolint/object-tree/evidence/readback.schema.json",
  "title": "PangoScript Object Readback Evidence Report",
  "type": "object",
  "required": ["schemaVersion", "runtime", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtime": {
      "type": "object",
      "required": ["observedAt", "operatorSupervised"],
      "properties": {
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "beyondVersion": {
          "type": "string",
          "minLength": 1
        },
        "operatorSupervised": {
          "const": true
        },
        "noLaserConnected": {
          "type": "boolean"
        },
        "talkHost": {
          "type": "string",
          "minLength": 1
        },
        "talkPort": {
          "type": "integer"
        },
        "oscListenHost": {
          "type": "string",
          "minLength": 1
        },
        "oscListenPort": {
          "type": "integer"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "parentIssue": {
      "type": "integer"
    },
    "batchIssue": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "required": [
        "objectPath",
        "probePath",
        "probeMode",
        "valueType",
        "baseline",
        "restore",
        "evidenceNote",
        "locationAware"
      ],
      "properties": {
        "objectPath": {
          "type": "string",
          "minLength": 1
        },
        "probePath": {
          "type": "string",
          "minLength": 1
        },
        "probeMode": {
          "const": "readback-only"
        },
        "valueType": {
          "enum": ["number", "integer", "float", "string", "boolean", "enum", "unknown"]
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "evidenceNote": {
          "type": "string",
          "minLength": 1
        },
        "locationAware": {
          "type": "boolean"
        },
        "locationContext": {
          "$ref": "#/$defs/locationContext"
        },
        "restore": {
          "$ref": "#/$defs/restore"
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": {
          "type": ["string", "number", "boolean", "null"]
        },
        "typeTag": {
          "enum": ["f", "i", "s"]
        }
      },
      "additionalProperties": false
    },
    "locationContext": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["indexed-root", "workspace-slot", "quickfx-slot", "showfile-alias", "hardware-instance"]
        },
        "populationDependent": {
          "type": "boolean"
        },
        "concreteContext": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "restore": {
      "type": "object",
      "required": ["strategy", "notes"],
      "properties": {
        "strategy": {
          "enum": ["not-needed", "restored-baseline", "command-restore", "manual-restore", "prefix-retired"]
        },
        "restoredValue": {
          "type": ["string", "number", "boolean", "null"]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}

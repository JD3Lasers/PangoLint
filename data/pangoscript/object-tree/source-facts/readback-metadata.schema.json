{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jd3/pangolint/object-tree/source-facts/readback-metadata.schema.json",
  "title": "PangoScript Object Tree Readback Metadata",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectPropertyReadbackEntry"
      }
    }
  },
  "$defs": {
    "objectPropertyReadbackEntry": {
      "type": "object",
      "required": ["path", "readable", "probePath", "probeMode", "evidenceLevel"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Object Tree path or normalized path from the Object Tree runtime index."
        },
        "readable": {
          "const": true
        },
        "accessMechanism": {
          "enum": ["pangoscript-expression", "osc-object-bus"]
        },
        "valueType": {
          "enum": ["number", "integer", "float", "string", "boolean", "enum", "unknown"]
        },
        "probePath": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete path used for the readback probe."
        },
        "probeMode": {
          "const": "readback-only"
        },
        "observedValue": {
          "type": ["string", "number", "boolean", "null"]
        },
        "typeTag": {
          "enum": ["f", "i", "s"]
        },
        "evidenceLevel": {
          "enum": ["documented", "observed", "inferred", "unverified"]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "locationContext": {
          "$ref": "#/$defs/locationContext"
        }
      },
      "additionalProperties": false
    },
    "locationContext": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["indexed-root", "workspace-slot", "quickfx-slot", "showfile-alias", "hardware-instance"]
        },
        "populationDependent": {
          "type": "boolean"
        },
        "indexBasis": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}

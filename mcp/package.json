{
  "name": "pangolint-mcp",
  "version": "0.7.28",
  "description": "MCP server exposing PangoLint's curated PangoScript knowledge to AI coding agents.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/JD3Lasers/PangoLint.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/JD3Lasers/PangoLint/issues"
  },
  "homepage": "https://github.com/JD3Lasers/PangoLint#readme",
  "keywords": [
    "pangoscript",
    "pangolin",
    "beyond",
    "laser",
    "mcp",
    "agent"
  ],
  "type": "module",
  "bin": {
    "pangolint-mcp": "./bin/pangolint-mcp.js"
  },
  "files": [
    "LICENSE",
    "bin/",
    "dist/",
    "data/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "compile": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "copy:assets": "node ../scripts/package/copyMcpData.cjs",
    "prepare:tarball": "npm run compile && npm run copy:assets",
    "package:tarball": "npm run prepare:tarball && npm pack",
    "verify:tarball": "npm run prepare:tarball && node ../scripts/package/verifyMcpPackageContents.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  }
}
